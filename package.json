{
  "name": "meatualiza",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:firebase": "firebase emulators:exec --project demo-meatualiza --only auth,firestore \"node --conditions=react-server --test tests/firebase/*.test.mjs\"",
    "test:auth": "firebase emulators:exec --project demo-meatualiza --only auth,firestore \"playwright test --config playwright.auth.config.ts\"",
    "emulators": "firebase emulators:start --project demo-meatualiza --only auth,firestore",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.34.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
