# Local development only. Copy to .env.local. No cloud credentials are needed.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-meatualiza.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-meatualiza
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true

FIREBASE_PROJECT_ID=demo-meatualiza
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
APP_ORIGIN=http://localhost:3000

# For real Firebase: replace the public values, set USE_EMULATORS=false,
# remove both EMULATOR_HOST variables and set FIREBASE_PROJECT_ID.
# The server uses Application Default Credentials. If using a local key file,
# keep it outside Git (e.g. .secrets/) and set GOOGLE_APPLICATION_CREDENTIALS
# to its absolute path. Never use NEXT_PUBLIC_ for administrative credentials.
